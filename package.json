{
  "name": "@benjamin-abud/design-system",
  "version": "1.0.0",
  "description": "Design System de Benjamín Abud: tokens DTCG exportados de Figma, compilados con Style Dictionary a custom properties CSS Color 4, con contraste WCAG, axe-core y Lighthouse. No está publicado en npm: linkeá tokens.css o cloná el repo.",
  "license": "MIT",
  "private": true,
  "author": "Benjamín Abud <bandresabudh@gmail.com> (https://benjaabud.framer.website)",
  "homepage": "https://benjaabud.framer.website/sistema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baah07/benjamin-abud-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/Baah07/benjamin-abud-design-system/issues"
  },
  "keywords": ["design-system", "design-tokens", "dtcg", "style-dictionary", "figma", "oklch", "wcag", "accessibility"],
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./tokens.js",
  "module": "./tokens.js",
  "types": "./tokens.d.ts",
  "exports": {
    ".": {
      "types": "./tokens.d.ts",
      "import": "./tokens.js",
      "default": "./tokens.js"
    },
    "./css": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./tokens.resolver.json": "./tokens.resolver.json",
    "./components-api.json": "./components-api.json",
    "./package.json": "./package.json"
  },
  "files": ["tokens.js", "tokens.d.ts", "tokens.css", "tokens.json", "tokens.resolver.json", "components-api.json", "DESIGN.md"],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "normalize": "node scripts/normalize.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:assets": "node scripts/build-readme-assets.mjs",
    "build": "npm run normalize && npm run build:tokens && npm run build:docs && npm run build:site",
    "validate": "node scripts/validate-dtcg.mjs && node scripts/crosscheck-plugin-css.mjs && node scripts/contrast-pairs.mjs",
    "audit:axe": "node scripts/audit-axe.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit": "npm run audit:axe && npm run audit:lighthouse"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "axe-core": "^4.14.0",
    "chromatic": "^18.13.9",
    "chrome-launcher": "^1.2.2",
    "colorjs.io": "^0.7.1",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "storybook-addon-pseudo-states": "^10.6.5",
    "style-dictionary": "^5.7.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vitest": "^5.1.0"
  }
}
