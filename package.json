{
  "name": "@benjamin-abud/design-system",
  "version": "1.0.0",
  "description": "Benjamín Abud's design system: DTCG tokens exported from Figma, built with Style Dictionary into CSS Color 4 custom properties, with WCAG contrast, axe-core and Lighthouse checks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./tokens.resolver.json": "./tokens.resolver.json",
    "./tokens.js": "./tokens.js"
  },
  "scripts": {
    "test": "node --test",
    "normalize": "node scripts/normalize.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run normalize && npm run build:tokens && npm run build:pages && npm run build:site",
    "validate": "node scripts/validate-dtcg.mjs && node scripts/contrast-pairs.mjs",
    "audit:axe": "node scripts/audit-axe.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit": "npm run audit:axe && npm run audit:lighthouse"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "axe-core": "^4.14.0",
    "chromatic": "^18.13.9",
    "chrome-launcher": "^1.2.2",
    "colorjs.io": "^0.7.1",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "storybook-addon-pseudo-states": "^10.6.5",
    "style-dictionary": "^5.7.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vitest": "^5.1.0"
  }
}
